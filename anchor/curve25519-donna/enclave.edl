enclave {
    trusted {
        /*
         * X25519 scalar multiply: out = curve25519_donna(sk, bp).
         * sk/bp/out are 32-byte little-endian field/scalar encodings (RFC 7748).
         */
        public void ecall_curve25519(
            [in, count=32] const uint8_t *sk,
            [in, count=32] const uint8_t *bp,
            [out, count=32] uint8_t *out);

        /* RFC 7748 Diffie-Hellman with all-zero shared-secret rejection. */
        public int ecall_curve25519_shared_secret(
            [in, count=32] const uint8_t *sk,
            [in, count=32] const uint8_t *peer_pk,
            [out, count=32] uint8_t *out);
    };
};
